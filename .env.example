# =============================================================================
# DocMind 环境变量模板
#
# 使用方式: 复制为 .env 后按需修改
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# 所有变量均以 DOCMIND_ 开头, 避免与系统通用变量(DEBUG/HOST/PORT)冲突.
# 带 * 的为必填或强烈建议修改项.
# =============================================================================

# ---------------------------- 应用基础 -------------------------------------
DOCMIND_APP_ENV=dev                  # dev | test | prod
DOCMIND_DEBUG=true
DOCMIND_HOST=0.0.0.0
DOCMIND_PORT=8000
DOCMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------- 大模型(必填) --------------------------------
# * 去 https://platform.deepseek.com 申请, 形如 sk-xxxxxxxx
DOCMIND_LLM_API_KEY=
DOCMIND_LLM_BASE_URL=https://api.deepseek.com/v1
DOCMIND_LLM_MODEL=deepseek-chat
DOCMIND_LLM_TEMPERATURE=0.1          # 问答场景压低温度以抑制幻觉
DOCMIND_LLM_MAX_TOKENS=2048
DOCMIND_LLM_TIMEOUT=60

# ---------------------------- Embedding ------------------------------------
DOCMIND_EMBEDDING_PROVIDER=local     # local | openai
DOCMIND_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
DOCMIND_EMBEDDING_DIM=512
DOCMIND_EMBEDDING_DEVICE=cpu         # cpu | cuda  (有显卡可改 cuda, 但小模型 CPU 已够快)
DOCMIND_EMBEDDING_BATCH_SIZE=32

# 国内下载 HuggingFace 模型慢/失败时打开镜像(首次下载必须, 之后可注释)
HF_ENDPOINT=https://hf-mirror.com

# ---------------------------- Rerank 精排 ----------------------------------
DOCMIND_RERANK_ENABLED=true
DOCMIND_RERANK_MODEL=BAAI/bge-reranker-base
DOCMIND_RERANK_DEVICE=cpu
DOCMIND_RERANK_TOP_N=5
# 精排分数低于该阈值 -> 判定文档中无相关内容 -> 直接拒答.
# 初始设 0(不拒答), 跑完评测集后再根据分数分布调优, 这是防幻觉的关键旋钮.
DOCMIND_RERANK_MIN_SCORE=0.0

# ---------------------------- 分块策略 -------------------------------------
# 父子块(Small-to-Big): 子块用于向量检索保精度, 父块作为上下文喂给 LLM 保完整
DOCMIND_PARENT_CHUNK_SIZE=1500
DOCMIND_CHILD_CHUNK_SIZE=300
DOCMIND_CHUNK_OVERLAP=50

# ---------------------------- 检索参数 -------------------------------------
DOCMIND_VECTOR_TOP_K=20              # 向量召回条数
DOCMIND_BM25_TOP_K=20                # 关键词召回条数
DOCMIND_RRF_K=60                     # RRF 融合常数, 经验值
DOCMIND_FINAL_TOP_K=5                # 精排后最终进入 Prompt 的条数

# ---------------------------- 存储 -----------------------------------------
DOCMIND_CHROMA_MODE=embedded         # embedded | http
DOCMIND_CHROMA_PERSIST_DIR=data/chroma
DOCMIND_CHROMA_COLLECTION=docmind_chunks
DOCMIND_DATABASE_URL=sqlite+aiosqlite:///./data/docmind.db
DOCMIND_REDIS_URL=redis://localhost:6379/0

# 任务模式: inline = 请求内同步执行(开发用, 无需 Redis)
#           queue  = 投递 Redis 队列, 由 Worker 异步消费(生产用)
DOCMIND_TASK_MODE=inline

# ---------------------------- 上传限制 -------------------------------------
DOCMIND_MAX_UPLOAD_SIZE_MB=50
DOCMIND_ALLOWED_EXTENSIONS=.pdf
DOCMIND_OCR_FALLBACK_THRESHOLD=80    # 单页抽取字符数低于此值判定为扫描件
